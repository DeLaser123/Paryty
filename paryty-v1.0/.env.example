# Paryty Environment Variables

# Agent Configuration
PARYTY_AGENT_CONFIG=configs/agent/agent.yaml
PARYTY_API_KEY=your-api-key-here
PARYTY_CLUSTER_ENDPOINT=grpc://localhost:443

# Cluster Configuration
REDPANDA_URL=PLAINTEXT://localhost:9092
DRAGONFLY_URL=redis://localhost:6379
QUESTDB_URL=postgres://paryty:paryty@localhost:5432/paryty
POSTGRES_URL=postgres://paryty:paryty@localhost:5432/paryty
SEAWEEDFS_ENDPOINT=localhost:8333
SEAWEEDFS_ACCESS_KEY=paryty
SEAWEEDFS_SECRET_KEY=paryty123

# Frontend Configuration
# Use 127.0.0.1:18080 — never "localhost" (IPv6/WSL2 relay issues).
# Port 18080 avoids WSL2 port-relay conflicts on default 8080.
VITE_API_URL=http://127.0.0.1:18080
VITE_WS_URL=ws://127.0.0.1:18080

# Logging
LOG_LEVEL=info
LOG_FORMAT=json
